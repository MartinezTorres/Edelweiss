// Probability: skip=0, low=1, medium=2, high=3. Item: none=0, heart=1,
// one rupee=2, five rupees=3, twenty rupees=4. A roll of 256 requests a draw.
#Drop(item:#u8,draw:#u8);
[[c_binding(drop_roll,full,1,exclusive)]]
&^drop_roll(probability:#u8,existing:#u8,roll:#u16) {
    probability<1 || probability>3 ? #Drop(existing,0) : (
    roll>255 ? #Drop(0,1) : (
    probability==1 ? #Drop(roll<8 ? 4 : (roll<24 ? 3 : (roll<56 ? 2 : (roll<72 ? 1 : 0))),0) : (
    probability==2 ? #Drop(roll<32 ? 4 : (roll<64 ? 3 : (roll<96 ? 2 : (roll<128 ? 1 : 0))),0) :
    #Drop(roll<64 ? 4 : (roll<128 ? 3 : (roll<160 ? 2 : (roll<192 ? 1 : 0))),0))))
}
#Pickup(life:#u8,credit:#u8);
[[c_binding(drop_collect,full,1,exclusive)]]
&^drop_collect(item:#u8,life:#u8,maximum:#u8) {
    healed:#u8=life+2;
    (#Pickup(item==1 ? (healed>maximum ? maximum : healed) : life,
             item==2 ? 1 : (item==3 ? 5 : (item==4 ? 20 : 0))))
}

// A frame of 255 leaves the pending sprite unchanged. Unknown nonzero items
// keep the legacy lifetime/collision behavior without inventing an asset.
#DropSpawn(enabled:#u8,frame:#u8);
[[c_binding(drop_spawn,full,1,exclusive)]]
&^drop_spawn(item:#u8) {
    #DropSpawn(item==0 ? 0 : 1,item>=1 && item<=4 ? item-1 : (#u8)255)
}

// Collapse elapsed ticks to the last visible write. Reaching counter 240 is
// still live; trying to process it expires before the collision query. A zero
// elapsed interval keeps visibility and permits collection even at counter 240.
// The engine's bool is an enum: blinking writes 0 or 8, not a normalized 1.
#DropStep(live:#u8,counter:#u8,visible:#u8);
[[c_binding(drop_step,full,8,exclusive)]]
&^drop_step(item:#u8,counter:#u8,elapsed:#u8) {
    room:#u8=counter<240 ? 240-counter : (#u8)0;
    spent:#u8=elapsed<room ? elapsed : room;
    last:#u8=counter+spent-1;
    item==0 ? #DropStep(0,counter,255) :
      #DropStep(elapsed<=room ? 1 : 0,counter+spent,
        spent==0 ? (#u8)255 : (last<14 ? (#u8)0 : (last<180 ? (#u8)1 : last&8)))
}

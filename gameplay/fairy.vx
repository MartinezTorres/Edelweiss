// Quarter-wave samples preserve the original 64-phase motion exactly.
// Reflection and sign define the other quarters. The solver can evaluate this
// finite rule into a bank-local ROM table; that representation is not gameplay
// policy and needs no duplicate C implementation in the Vexel build.
&fairy_height(q:#u8)->#u8 {
 q==16 ? (#u8)120 : (q<8 ?
   (q<4 ? (q<2 ? (q==0 ? (#u8)0 : (#u8)12) : (q==2 ? (#u8)23 : (#u8)35)) :
          (q<6 ? (q==4 ? (#u8)46 : (#u8)57) : (q==6 ? (#u8)67 : (#u8)76))) :
   (q<12 ? (q<10 ? (q==8 ? (#u8)85 : (#u8)93) : (q==10 ? (#u8)100 : (#u8)106)) :
           (q<14 ? (q==12 ? (#u8)111 : (#u8)115) : (q==14 ? (#u8)118 : (#u8)119))))
}
[[c_binding(fairy_move,full,4,exclusive)]]
&^fairy_move(anchor:#u8,clock:#u8)->#u16 {
 phase:#u8=(clock>>1)&63;
 q:#u8=(phase&16)!=0 ? 16-(phase&15) : phase&15;
 height:#u16=(#u16)fairy_height(q);
 offset:#u16=(phase&32)==0 ? height : (#u16)0-height;
 ((#u16)anchor<<8)+offset
}

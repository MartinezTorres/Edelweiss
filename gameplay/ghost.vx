// All persistent entity state remains in the engine. Coordinates wrap at
// 16 bits and velocities at 8 bits, matching the original MSX arithmetic.
::ghost_assets;
#GhostSpawn(i:#u16,j:#u16,vi:#i8,vj:#i8);
[[c_binding(ghost_spawn,full,1,exclusive)]]
&^ghost_spawn(ai:#u16,aj:#u16,random:#u8) {
    vi:#i8=(random&1)!=0 ? -1 : 1;
    vj:#i8=(random&2)!=0 ? -2 : 2;
    (#GhostSpawn(ai-256,aj-512,
        (random&4)!=0 ? vi+vi : vi,(random&8)!=0 ? vj+vj : vj))
}
// The backend shares this value where position and velocity both use it,
// and lowers constant division according to the target's integer rules.
&ghost_velocity(position:#u16,anchor:#u16,velocity:#i8,player:#u16)->#i8 {
    delta:#i16=(#i16)(anchor-position);
    anchored:#i8=velocity+(#i8)(delta/512);
    anchored+(player<position ? (#i8)-1 : (#i8)1)
}
#GhostMotion(position:#u16,velocity:#i8);
&ghost_axis(position:#u16,anchor:#u16,velocity:#i8,player:#u16) {
    next=ghost_velocity(position,anchor,velocity,player);
    (#GhostMotion(position+(#u16)next+(#u16)next,next))
}
&ghost_frame(slot:#u8,velocity:#i8)->#u8 {
    variant:#u8=(slot&7)==0 ? 0 : ((slot&7)==1 ? 2 : (
        (slot&7)==3 ? 6 : ((slot&7)<6 ? 4 : 10)));
    variant+(velocity>0 ? 0 : 1)
}

// One observable update lets the backend see the cadence guard, both axes,
// shared velocities and frame selection together. Unused inactive fields
// are zero; the engine applies results only when run is set.
#GhostUpdate(run:#u8,life:#u8,i:#u16,j:#u16,vi:#i8,vj:#i8,frame:#u8);
[[c_binding(ghost_move,case1,16,exclusive)]]
&^ghost_update(cycle:#u8,slot:#u8,maximum:#u8,
    i:#u16,j:#u16,ai:#u16,aj:#u16,vi:#i8,vj:#i8,pi:#u16,pj:#u16) {
    ((cycle+slot)&3)==0 ? {
        ni=ghost_axis(i,ai,vi,pi);
        nj=ghost_axis(j,aj,vj,pj);
        (#GhostUpdate(1,maximum,ni.position,nj.position,ni.velocity,nj.velocity,
            ghost_frame(slot,nj.velocity)))
    } : #GhostUpdate(0,0,0,0,0,0,0)
}
